{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mychat",
  "main": "src/index.js",
  "compatibility_date": "2025-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // 所有请求先经过 Worker,由 Worker 决定是否放行静态资源(用于登录保护)
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
