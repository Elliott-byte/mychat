{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mychat",
  "main": "src/index.js",
  "compatibility_date": "2025-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // 所有请求先经过 Worker,由 Worker 决定是否放行静态资源(用于登录保护)
    "run_worker_first": true
  },
  // 聊天历史存储。一键部署时 Cloudflare 会自动创建这个数据库并回填 database_id。
  // 表结构由 Worker 首次运行时自动建立,无需手动执行 migration。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mychat-history",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "observability": {
    "enabled": true
  }
}
