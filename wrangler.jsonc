{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mychat",
  "main": "src/index.js",
  "compatibility_date": "2025-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // 所有请求先经过 Worker,由 Worker 决定是否放行静态资源(用于登录保护)
    "run_worker_first": true
  },
  // 聊天历史存储。
  // 这里刻意不写 database_id:wrangler 4.45+ 见到该字段缺失才会自动创建数据库。
  // 反过来,填任何非空值(哪怕是占位符)都会让它认为「已配置完整」而跳过创建,
  // 然后把这个不存在的 ID 发给 API,部署直接失败(错误码 10021)。
  // 表结构由 Worker 首次运行时自动建立,无需执行 migration。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mychat-history"
    }
  ],
  "observability": {
    "enabled": true
  }
}
