{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mychat",
	"main": "src/index.js",
	"compatibility_date": "2025-08-01",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// Every request hits the Worker first so it can gate static assets behind login
		"run_worker_first": true
	},
	// Chat history. The database_id below is the real value wrangler wrote back
	// after auto-creating the database on first deploy; keep it so later deploys
	// keep pointing at the same database.
	// ⚠️ Deploying to a different account? Delete the database_id line entirely and
	//    let wrangler provision a new one. Never substitute a placeholder: wrangler
	//    treats any non-empty value as "fully configured", skips provisioning, and
	//    ships the nonexistent id to the API, failing the deploy outright (code
	//    10021). Requires wrangler >= 4.45.0.
	// The schema is created by the Worker on first run — no migration step needed.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mychat-history",
			"database_id": "0e748954-10ee-408d-b68a-7449770bb890"
		}
	],
	// Build the frontend before deploy and local dev, so neither CI nor a local
	// run can ship a stale bundle
	"build": {
		"command": "npm run build"
	},
	"observability": {
		"enabled": true
	}
}