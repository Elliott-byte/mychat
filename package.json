{
  "name": "mychat",
  "version": "1.0.0",
  "private": true,
  "description": "私人 AI 试用台 — Cloudflare Workers + OpenRouter,支持最新模型自动更新",
  "scripts": {
    "build": "vite build",
    "dev": "wrangler dev",
    "dev:ui": "vite",
    "deploy": "wrangler deploy",
    "test": "npm run build && node test/smoke.mjs",
    "secret:key": "wrangler secret put OPENROUTER_API_KEY",
    "secret:pass": "wrangler secret put MASTER_PASSWORD"
  },
  "cloudflare": {
    "label": "MyChat — 私人 AI 试用台",
    "products": [
      "Workers"
    ],
    "categories": [
      "ai"
    ],
    "docs_url": "https://github.com/Elliott-byte/mychat#readme",
    "bindings": {
      "OPENROUTER_API_KEY": {
        "description": "你的 OpenRouter API Key。到 [openrouter.ai/keys](https://openrouter.ai/keys) 创建,格式形如 `sk-or-v1-...`。它只保存在服务端,永远不会发送到浏览器。"
      },
      "MASTER_PASSWORD": {
        "description": "登录本站的主密码,**只有你知道**。请用强密码(建议 16 位以上随机字符),可以用 `openssl rand -base64 24` 生成。"
      }
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^29.1.1",
    "vite": "^8.2.1",
    "wrangler": "^4.45.0"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "lowlight": "^3.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
